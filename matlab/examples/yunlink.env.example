# 所有 MATLAB examples/*.m 共用这一份目标配置（与 Python 示例同一套键）。
# 复制为同目录的 yunlink.env 后填写。不要改示例脚本中间的变量。
# 系统环境变量同名键可以临时覆盖本文件。

# Bridge TCP 地址，格式 ip:9696。留空则尝试搜索唯一 Bridge。
YUNLINK_ADDRESS=

# 多 Bridge 时按 endpoint_uid 选择（ex10_discover_select_connect）。
YUNLINK_BRIDGE_ID=

# 填 entity_uid，不要填显示名 uav1 / ugv1。
# 先跑 ex01_discover / ex02_connect_and_inspect，把表里「entity_uid」那一列贴过来。
YUNLINK_UAV=
YUNLINK_UGV=

# 搜索 Bridge 的秒数。
YUNLINK_DISCOVER_TIMEOUT=5
