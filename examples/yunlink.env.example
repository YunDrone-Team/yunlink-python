# 所有 examples/*.py 共用这一份目标配置。
# 复制为同目录的 yunlink.env 后填写，不必每次 export。
# 命令行 --address / --entity / --id 仍可临时覆盖本文件。

# Bridge TCP 地址。留空则尝试搜索唯一 Bridge。
YUNLINK_ADDRESS=

# 多 Bridge 时按 endpoint_uid 选择，对应 examples/10_discover_select_connect.py --id
YUNLINK_BRIDGE_ID=

# 无人机 / 无人车的 entity_uid。先跑 01_discover.py / 02_connect_and_inspect.py 再填。
YUNLINK_UAV=
YUNLINK_UGV=

# 搜索 Bridge 的监听秒数。默认 5，听满后再统一打印。
YUNLINK_DISCOVER_TIMEOUT=5
